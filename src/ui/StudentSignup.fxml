<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!--
    ============================================================
     SAPCIS - Student Registration Screen
     Modern Light Theme with Course Dashboard Style
     Color Palette: Hadfield Blue, Valhalla, Wash Me
     Controller: ui.AuthUIController
    ============================================================
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ui.AuthUIController"
           alignment="CENTER"
           prefWidth="900.0"
           prefHeight="750.0"
           styleClass="login-root"
           stylesheets="@styles.css">

    <!-- Registration Card -->
    <ScrollPane fitToWidth="true" 
                style="-fx-background-color: transparent; -fx-background: transparent;"
                hbarPolicy="NEVER">
        <VBox alignment="CENTER" spacing="0">
            <padding>
                <Insets top="40" bottom="40" />
            </padding>
            
            <VBox alignment="CENTER"
                  maxWidth="480.0"
                  spacing="16.0"
                  styleClass="login-card">

                <!-- Logo / Brand -->
                <HBox alignment="CENTER" spacing="10">
                    <Circle radius="8" style="-fx-fill: #1572FE;" />
                    <Label text="SAPCIS" styleClass="login-logo" />
                </HBox>

                <Region prefHeight="2.0" />

                <!-- Header -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="Create Account" styleClass="login-title" />
                    <Label text="Register as a new student" styleClass="login-subtitle" />
                </VBox>

                <Region prefHeight="4.0" />

                <!-- Roll Number -->
                <VBox spacing="6.0" maxWidth="380">
                    <Label text="Roll Number" styleClass="form-label" />
                    <TextField fx:id="rollNoField"
                               promptText="e.g. 21K-3456"
                               styleClass="form-field"
                               prefHeight="44" />
                </VBox>

                <!-- Full Name -->
                <VBox spacing="6.0" maxWidth="380">
                    <Label text="Full Name" styleClass="form-label" />
                    <TextField fx:id="nameField"
                               promptText="Enter your full name"
                               styleClass="form-field"
                               prefHeight="44" />
                </VBox>

                <!-- Email -->
                <VBox spacing="6.0" maxWidth="380">
                    <Label text="Email" styleClass="form-label" />
                    <TextField fx:id="signupEmailField"
                               promptText="you@university.edu"
                               styleClass="form-field"
                               prefHeight="44" />
                </VBox>

                <!-- Password -->
                <VBox spacing="6.0" maxWidth="380">
                    <Label text="Password" styleClass="form-label" />
                    <PasswordField fx:id="signupPasswordField"
                                   promptText="Create a strong password (min 6 chars)"
                                   styleClass="form-field"
                                   prefHeight="44" />
                </VBox>

                <!-- Batch Selection -->
                <VBox spacing="6.0" maxWidth="380">
                    <Label text="Batch" styleClass="form-label" />
                    <ComboBox fx:id="batchComboBox"
                              promptText="Select your batch"
                              prefWidth="380"
                              prefHeight="44"
                              styleClass="form-field" />
                </VBox>

                <!-- Department Selection -->
                <VBox spacing="6.0" maxWidth="380">
                    <Label text="Department" styleClass="form-label" />
                    <ComboBox fx:id="departmentComboBox"
                              promptText="Select your department"
                              prefWidth="380"
                              prefHeight="44"
                              styleClass="form-field" />
                </VBox>

                <!-- Section Selection -->
                <VBox spacing="6.0" maxWidth="380">
                    <Label text="Section" styleClass="form-label" />
                    <ComboBox fx:id="sectionComboBox"
                              promptText="Select your section"
                              prefWidth="380"
                              prefHeight="44"
                              styleClass="form-field" />
                </VBox>

                <Region prefHeight="6.0" />

                <!-- Register Button -->
                <Button fx:id="signupButton"
                        text="Create Account"
                        onAction="#onSignupClicked"
                        prefWidth="380"
                        prefHeight="50"
                        styleClass="btn-success" />

                <!-- Status / Error Message -->
                <Label fx:id="signupMessageLabel"
                       wrapText="true"
                       maxWidth="380"
                       styleClass="message-error" />

                <Region prefHeight="4.0" />

                <!-- Footer link -->
                <HBox alignment="CENTER" spacing="6.0">
                    <Label text="Already have an account?"
                           styleClass="login-subtitle" />
                    <Hyperlink text="Sign In"
                               onAction="#onBackToLoginClicked"
                               styleClass="link-text" />
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
