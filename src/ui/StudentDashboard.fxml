<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!--
    ============================================================
     SAPCIS - Student Dashboard (UC-04)
     Modern Light Theme with Course Dashboard Style
     Color Palette: Hadfield Blue, Valhalla, Wash Me
     Controller: ui.StudentDashboardController
    ============================================================
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.StudentDashboardController"
            prefWidth="1200.0"
            prefHeight="760.0"
            stylesheets="@styles.css"
            style="-fx-background-color: #FBFCFE;">

    <!-- TOP: Header Bar -->
    <top>
        <VBox fx:id="alertsBanner"
              spacing="8.0"
              style="-fx-background-color: #FFFFFF;
                     -fx-effect: dropshadow(gaussian, rgba(41, 41, 64, 0.06), 8, 0, 0, 2);">
            <padding>
                <Insets top="16.0" right="28.0" bottom="16.0" left="28.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Circle radius="6" style="-fx-fill: #1572FE;" />
                    <Label text="SAPCIS"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1572FE;" />
                </HBox>
                
                <Label text="Student Dashboard"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #6B7280;" />
                
                <Region HBox.hgrow="ALWAYS" />
                
                <Label fx:id="todayLabel"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #1572FE;
                              -fx-font-weight: 600;" />
                
                <Button fx:id="logoutButton"
                        text="Logout"
                        onAction="#onLogoutClicked"
                        styleClass="btn-secondary"
                        style="-fx-padding: 8 18 8 18;" />
            </HBox>

            <!-- Dynamic alerts container -->
            <VBox fx:id="alertsContainer"
                  spacing="8.0"
                  visible="false"
                  managed="false" />
        </VBox>
    </top>

    <!-- LEFT: Sidebar -->
    <left>
        <VBox spacing="20.0"
              prefWidth="280.0"
              styleClass="sidebar"
              style="-fx-background-color: #FFFFFF;
                     -fx-border-color: #E2E6EE;
                     -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="24.0" right="20.0" bottom="24.0" left="20.0" />
            </padding>

            <!-- Profile Card (Blue gradient like course cards) -->
            <VBox spacing="12.0"
                  style="-fx-background-color: linear-gradient(to bottom right, #1572FE, #4A94FF);
                         -fx-background-radius: 16;
                         -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(21, 114, 254, 0.3), 12, 0.1, 0, 4);">
                <Label text="PROFILE"
                       style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: rgba(255,255,255,0.7);" />
                <Label fx:id="profileNameLabel"
                       text="—"
                       wrapText="true"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #FFFFFF;" />
                <Label fx:id="profileRollNoLabel"
                       text="Roll No: —"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: rgba(255,255,255,0.85);" />
                <Label fx:id="profileDeptLabel"
                       text="Department: —"
                       wrapText="true"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: rgba(255,255,255,0.85);" />
                <Label fx:id="profileSectionLabel"
                       text="Section: —"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: rgba(255,255,255,0.85);" />
            </VBox>

            <Separator style="-fx-background-color: #E2E6EE;" />

            <!-- Smart Alerts Toggle -->
            <VBox spacing="8.0">
                <Label text="NOTIFICATIONS"
                       style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #6B7280;" />
                <CheckBox fx:id="smartAlertsCheckBox"
                          text="Subscribe to Smart Alerts"
                          onAction="#onSmartAlertsToggled"
                          style="-fx-font-size: 14px;
                                 -fx-text-fill: #292940;" />
                <Label text="Get notified instantly when your classes are cancelled, delayed, or moved."
                       wrapText="true"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #9CA3AF;" />
            </VBox>

            <Separator style="-fx-background-color: #E2E6EE;" />

            <!-- Today's Stats (Card style) -->
            <VBox spacing="10.0"
                  style="-fx-background-color: #F8FAFC;
                         -fx-background-radius: 12;
                         -fx-padding: 16;
                         -fx-border-color: #E2E6EE;
                         -fx-border-radius: 12;">
                <Label text="TODAY AT A GLANCE"
                       style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #6B7280;" />
                <Label fx:id="statTotalLabel"
                       text="Total classes: 0"
                       style="-fx-font-size: 14px; -fx-text-fill: #292940; -fx-font-weight: 600;" />
                <HBox spacing="16">
                    <Label fx:id="statOngoingLabel"
                           text="Ongoing: 0"
                           style="-fx-font-size: 13px; -fx-text-fill: #34C759;" />
                    <Label fx:id="statDelayedLabel"
                           text="Delayed: 0"
                           style="-fx-font-size: 13px; -fx-text-fill: #EEAC5C;" />
                </HBox>
                <Label fx:id="statCancelledLabel"
                       text="Cancelled: 0"
                       style="-fx-font-size: 13px; -fx-text-fill: #FF3B30;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="refreshButton"
                    text="↻  Refresh Schedule"
                    onAction="#onRefreshClicked"
                    maxWidth="Infinity"
                    styleClass="btn-primary"
                    style="-fx-padding: 12 0 12 0;" />
        </VBox>
    </left>

    <!-- CENTER: Main Content Area -->
    <center>
        <StackPane style="-fx-background-color: #FBFCFE;">
            <padding>
                <Insets top="20.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>

            <TabPane fx:id="mainTabPane"
                     tabClosingPolicy="UNAVAILABLE"
                     style="-fx-background-color: #FFFFFF;
                            -fx-background-radius: 16;
                            -fx-effect: dropshadow(gaussian, rgba(41, 41, 64, 0.08), 16, 0.1, 0, 4);">

                <!-- Tab 1: Today's Live Status -->
                <Tab text="📅  Today's Live Status">
                    <VBox spacing="14.0" style="-fx-background-color: #FFFFFF;">
                        <padding>
                            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Live status of your classes for TODAY"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #6B7280;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Auto-refreshes every 5 minutes"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #9CA3AF;" />
                        </HBox>

                        <!-- Nested TabPane for Today's sub-categories -->
                        <TabPane fx:id="todayTabPane"
                                 tabClosingPolicy="UNAVAILABLE"
                                 style="-fx-background-color: #F8FAFC;
                                        -fx-background-radius: 12;">

                            <Tab text="🟢 Ongoing">
                                <StackPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 0 0 12 12;">
                                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                                    <TableView fx:id="ongoingTable"
                                               style="-fx-background-color: transparent; -fx-font-size: 13px;" />
                                </StackPane>
                            </Tab>

                            <Tab text="⏳ Upcoming">
                                <StackPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 0 0 12 12;">
                                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                                    <TableView fx:id="upcomingTable"
                                               style="-fx-background-color: transparent; -fx-font-size: 13px;" />
                                </StackPane>
                            </Tab>

                            <Tab text="🟠 Delayed">
                                <StackPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 0 0 12 12;">
                                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                                    <TableView fx:id="delayedTable"
                                               style="-fx-background-color: transparent; -fx-font-size: 13px;" />
                                </StackPane>
                            </Tab>

                            <Tab text="🔴 Cancelled">
                                <StackPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 0 0 12 12;">
                                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                                    <TableView fx:id="cancelledTable"
                                               style="-fx-background-color: transparent; -fx-font-size: 13px;" />
                                </StackPane>
                            </Tab>
                        </TabPane>
                    </VBox>
                </Tab>

                <!-- Tab 2: Monday -->
                <Tab text="Monday">
                    <StackPane style="-fx-background-color: #FFFFFF;">
                        <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>
                        <TableView fx:id="mondayTable" style="-fx-font-size: 13px;" />
                    </StackPane>
                </Tab>

                <!-- Tab 3: Tuesday -->
                <Tab text="Tuesday">
                    <StackPane style="-fx-background-color: #FFFFFF;">
                        <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>
                        <TableView fx:id="tuesdayTable" style="-fx-font-size: 13px;" />
                    </StackPane>
                </Tab>

                <!-- Tab 4: Wednesday -->
                <Tab text="Wednesday">
                    <StackPane style="-fx-background-color: #FFFFFF;">
                        <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>
                        <TableView fx:id="wednesdayTable" style="-fx-font-size: 13px;" />
                    </StackPane>
                </Tab>

                <!-- Tab 5: Thursday -->
                <Tab text="Thursday">
                    <StackPane style="-fx-background-color: #FFFFFF;">
                        <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>
                        <TableView fx:id="thursdayTable" style="-fx-font-size: 13px;" />
                    </StackPane>
                </Tab>

                <!-- Tab 6: Friday -->
                <Tab text="Friday">
                    <StackPane style="-fx-background-color: #FFFFFF;">
                        <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>
                        <TableView fx:id="fridayTable" style="-fx-font-size: 13px;" />
                    </StackPane>
                </Tab>
            </TabPane>
        </StackPane>
    </center>
</BorderPane>
