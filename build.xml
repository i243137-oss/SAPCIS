<?xml version="1.0" encoding="UTF-8"?>
<project name="SAPCIS" default="compile" basedir=".">
    <description>SAPCIS - Smart Academic Planning &amp; Class Information System</description>

    <property name="src.dir" location="src"/>
    <property name="build.dir" location="build"/>
    <property name="classes.dir" location="${build.dir}/classes"/>
    <property name="dist.dir" location="dist-java"/>
    <property name="lib.dir" location="lib"/>

    <path id="classpath">
        <fileset dir="${lib.dir}" erroronmissingdir="false">
            <include name="**/*.jar"/>
        </fileset>
    </path>

    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init" description="compile the source">
        <!-- Copy non-java resource files such as .fxml, .css, .properties -->
        <copy todir="${classes.dir}">
            <fileset dir="${src.dir}">
                <exclude name="**/*.java"/>
            </fileset>
        </copy>
        <!-- Copy root db.properties if exists -->
        <copy file="db.properties" todir="${classes.dir}" failonerror="false"/>

        <javac srcdir="${src.dir}" destdir="${classes.dir}" classpathref="classpath" includeantruntime="false" source="11" target="11" debug="true"/>
    </target>

    <target name="dist" depends="compile" description="generate the distribution jar">
        <jar jarfile="${dist.dir}/SAPCIS.jar" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="Main"/>
            </manifest>
        </jar>
    </target>

    <target name="clean" description="clean up">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
